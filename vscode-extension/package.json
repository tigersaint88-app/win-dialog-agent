{
  "name": "win-dialog-agent",
  "displayName": "Win Dialog Agent",
  "description": "Semantic Windows dialog automation for AI agents (#32770 Save As / Open / MessageBox via UIA + MCP). By ForgeCopilot LLC.",
  "version": "0.1.0",
  "publisher": "forgecopilot",
  "author": {
    "name": "ForgeCopilot LLC"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#E8EEF5",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tigersaint88-app/win-dialog-agent.git"
  },
  "homepage": "https://github.com/tigersaint88-app/win-dialog-agent#readme",
  "bugs": {
    "url": "https://github.com/tigersaint88-app/win-dialog-agent/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "mcp",
    "windows",
    "dialog",
    "uia",
    "agent",
    "automation",
    "forgecopilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "forgecopilot.win-dialog-agent",
        "label": "Win Dialog Agent (ForgeCopilot LLC)"
      }
    ],
    "configuration": {
      "title": "Win Dialog Agent",
      "properties": {
        "winDialogAgent.launchCommand": {
          "type": "string",
          "default": "uvx",
          "description": "Executable used to start the MCP server (uvx recommended)."
        },
        "winDialogAgent.launchArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--from",
            "git+https://github.com/tigersaint88-app/win-dialog-agent",
            "win-dialog-mcp"
          ],
          "description": "Arguments passed to launchCommand to start win-dialog-mcp over stdio."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.7.2"
  }
}
