# win-dialog-agent configuration / 配置示例
# Copy to .env and adjust. 复制为 .env 后按需修改。

# Default wait timeout in seconds for dialog appearance
WIN_DIALOG_DEFAULT_TIMEOUT=10

# Retry count / delay for flaky UIA lookups
WIN_DIALOG_RETRY_COUNT=3
WIN_DIALOG_RETRY_DELAY=0.3

# How long to wait for overwrite / secondary confirm dialogs
WIN_DIALOG_OVERWRITE_CONFIRM_TIMEOUT=2.0

# Log level: DEBUG, INFO, WARNING, ERROR
WIN_DIALOG_LOG_LEVEL=INFO
